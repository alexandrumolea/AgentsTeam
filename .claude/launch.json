{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "documente-ioana",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "team/ioana/documente"
      ],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "site/serve.mjs",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "curs-editor",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "curs/editor.mjs",
        "privat/cursuri/change-agility",
        "--port",
        "4747",
        "--fara-browser"
      ],
      "port": 4747
    }
  ]
}